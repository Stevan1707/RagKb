# 后端服务配置（复制本文件为 .env 后按需修改）
APP_NAME=RagKb API
DEBUG=true

HOST=127.0.0.1
PORT=8000

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端调用统一前缀，便于以后调整
API_PREFIX=/api

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的数据库密码
DB_NAME=ragkb

# ---------- 入库 / 检索参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# 模型目录（相对 backend/）或 HuggingFace 模型名；本地目录存在时优先用本地
EMBED_MODEL=models/bge-small-zh-v1.5

# 相对路径以 backend/ 为基准，也可以填绝对路径
UPLOAD_DIR=data/uploads
FAISS_INDEX_PATH=data/faiss.index
