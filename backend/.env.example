# 后端服务配置（复制本文件为 .env 后按需修改）
APP_NAME=RagKb API
DEBUG=true

HOST=127.0.0.1
PORT=8000

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端调用统一前缀，便于以后调整
API_PREFIX=/api

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的数据库密码
DB_NAME=ragkb

# ---------- 入库 / 检索参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
# 检索策略：hybrid = 向量 + BM25 用 RRF 融合；vector / bm25 = 只走一路
RETRIEVAL_MODE=hybrid
# 每路召回的候选数，融合后再截断到 TOP_K
RECALL_K=20
# RRF 平滑常数，一般不用改
RRF_K=60
# BM25 参数：k1 控制词频饱和，b 控制长度惩罚
BM25_K1=1.5
BM25_B=0.75

# 模型目录（相对 backend/）或 HuggingFace 模型名；本地目录存在时优先用本地
EMBED_MODEL=models/bge-small-zh-v1.5

# 相对路径以 backend/ 为基准，也可以填绝对路径
UPLOAD_DIR=data/uploads
FAISS_INDEX_PATH=data/faiss.index

# ---------- 大模型（任意 OpenAI 兼容接口）----------
# 本机 Ollama:  http://127.0.0.1:11434/v1  +  ollama  +  ollama list 里的模型名
# DeepSeek:    https://api.deepseek.com/v1  +  sk-xxx  +  deepseek-chat
# 通义:        https://dashscope.aliyuncs.com/compatible-mode/v1  +  sk-xxx  +  qwen-plus
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:latest
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=400
LLM_TIMEOUT=120
# 思考型模型（qwen3 系列）设 none 可跳过推理直出正文；换厂商可留空
LLM_REASONING_EFFORT=none
# 带几轮历史进 prompt，0 = 单轮
LLM_HISTORY_TURNS=1

# ---------- OCR（扫描版 PDF / 图片）----------
# 需要可选依赖：pip install rapidocr-onnxruntime
OCR_ENABLED=true
# PDF 转图片的分辨率，越高越准也越慢
OCR_DPI=200
# 单份文档最多 OCR 多少页，防止几百页扫描件跑很久
OCR_MAX_PAGES=30
# 置信度低于这个值的识别结果直接丢弃（0~1，越高越严格）
OCR_MIN_SCORE=0.5

